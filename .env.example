# ==========================================
# VitaSync Monorepo Environment Configuration
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# API Server Settings
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Frontend Client Settings (apps/web)
VITE_API_URL=http://localhost:4000

