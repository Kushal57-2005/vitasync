{
  "name": "vitasync-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "VitaSync — Multi-user Android-first nutrition and fitness tracking application",
  "scripts": {
    "dev": "pnpm --parallel --filter @vitasync/api --filter @vitasync/web dev",
    "dev:api": "pnpm --filter @vitasync/api dev",
    "dev:web": "pnpm --filter @vitasync/web dev",
    "build": "pnpm --filter @vitasync/shared build && pnpm --filter @vitasync/api build && pnpm --filter @vitasync/web build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
